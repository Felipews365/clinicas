to_em_minúsculas} foi em {mês_por_extenso} de {ano}. Que tal agendar sua próxima manutenção? Estamos aqui para ajudar! 😊\"\\nLinha 2: (linha em branco)\\nLinha 3: \"Atenciosamente, ' + ($json.nome_agente || 'assistente') + ' da ' + ($json.clinic_name || 'clínica') + '.\"\\n\\nREGRAS DE PREENCHIMENTO:\\n- {primeiro_nome}: primeira palavra do campo nome do paciente.\\n- {procedimento_em_minúsculas}: campo procedimento do item mais recente em historico[], em minúsculas (ex.: \"limpeza\").\\n- {mês_por_extenso}: nome do mês em português (janeiro, fevereiro, …) extraído da data do item mais recente em historico[].\\n- {ano}: ano de 4 dígitos da mesma data.\\n\\nNÃO use travessão antes do nome. NÃO mude a estrutura, palavras ou emoji. NÃO invente histórico — use APENAS o array pacientes[]. Se nenhum paciente atende às regras, envios: [].' }, { role: 'user', content: 'REGRAS:\\n' + ($json.regras || '') + '\\n\\nPACIENTES (JSON):\\n' + JSON.stringify($json.pacientes) } ] }) }}","options":{},"infoMessage":""},"id":"li-llm","name":"LLM decide envios","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[960,0],"credentials":{"openAiApi":{"id":"v4dQPWdlMtUeGSD3","name":"OpenAi clinicas"}},"onError":"continueRegularOutput"},{"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"// Parse output do LLM e emite 1 item por envio.\nconst clinic = $('Um item por clínica').item.json;\nconst llm = $input.first().json;\nlet content = '';\ntry {\n  content = llm?.choices?.[0]?.message?.content || '';\n} catch { content = ''; }\nlet parsed = {};\ntry { parsed = JSON.parse(content); } catch { parsed = { envios: [] }; }\nconst envios = Array.isArray(parsed.envios) ? parsed.envios : [];\nconst byId = new Map((clinic.pacientes || []).map((p) => [String(p.cs_cliente_id), p]));\nconst out = [];\nfor (const e of envios) {\n  const p = byId.get(String(e.cs_cliente_id));\n  if (!p || !p.telefone) continue;\n  const msg = String(e.mensagem || '').trim();\n  if (!ms