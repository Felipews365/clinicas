      "id": "lc-rpc-pendentes",
      "name": "RPC consulta pendentes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "jsCode": "// A RPC devolve array directo. Pode chegar como string (raro) ou objecto.\nlet raw = $input.first().json;\nif (typeof raw === 'string') {\n  try { raw = JSON.parse(raw); } catch { raw = []; }\n}\nif (!Array.isArray(raw)) {\n  // n8n às vezes embrulha em { body: [...] }\n  if (raw && Array.isArray(raw.body)) raw = raw.body;\n  else raw = [];\n}\nif (raw.length === 0) {\n  return [{ json: { skip: true, reason: 'sem_pendentes' } }];\n}\nreturn raw.map((item) => {\n  const nome = String(item.nome_cliente || '').split(' ')[0] || 'tudo bem?';\n  const txt = String(item.mensagem_template || '')\n    .replace(/\\{\\{\\s*nome\\s*\\}\\}/gi, nome)\n    .replace(/\\{\\{\\s*data\\s*\\}\\}/gi, item.data_br || '')\n    .replace(/\\{\\{\\s*hora\\s*\\}\\}/gi, item.hora_br || '');\n  return { json: { ...item, mensagem: txt } };\n});"
      },
      "id": "lc-prepare",
      "name": "Renderiza mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "id": "tem-telefone",
              "leftValue": "={{ $json.telefone }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ]
        }
      },
      "id": "lc-if-send",
      "name": "Tem telefone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://evolutionapi.vps7846.panel.icontainer.cloud/message/sendText/' + $json.instance_name }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "apikey", "value": "6PWyAsF3cip8QZ2JxNSRk4M5A5yEi4G8" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.telefone, text: $json.mensagem, delay: 1200 }) }}",
        "options": { "batching": { "batch": { "batchSize": 1, "batchInterval": 1500 } } }
      },
      "id": "lc-evolution-send",
      "name": "Evolution sendText",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueErrorOutput",
      "position": [960, 0]
    },
    {
