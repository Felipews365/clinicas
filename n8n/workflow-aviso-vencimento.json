    {
      "parameters": {
        "jsCode": "// Cada linha já vem com clinic_id, clinic_name, instance_name, data_expiracao,\n// dias_restantes, destino_whatsapp, owner_email.\n// Renderiza mensagem fixa para o dono da clínica.\nconst items = $input.all();\nconst out = [];\nfor (const it of items) {\n  const r = it.json;\n  if (!r || !r.destino_whatsapp) continue;\n  const [y, m, d] = String(r.data_expiracao).slice(0, 10).split('-');\n  const dataBr = `${d}/${m}/${y}`;\n  const dias = Number(r.dias_restantes) || 3;\n  const nome = r.clinic_name || 'sua clínica';\n  const mensagem =\n    `Olá! 👋 Este é um aviso da plataforma sobre o plano de *${nome}*.\\n\\n` +\n    `⏰ Faltam *${dias} dia${dias === 1 ? '' : 's'}* para o vencimento.\\n` +\n    `📅 Data limite: *${dataBr}*\\n\\n` +\n    `Para evitar interrupção do atendimento automático no WhatsApp, entre em contacto com o suporte para renovar.\\n\\n` +\n    `Caso já tenha regularizado, ignore esta mensagem.`;\n  out.push({\n    json: {\n      ...r,\n      mensagem,\n    },\n  });\n}\nreturn out;"
      },
      "id": "av-render-msg",
      "name": "Renderiza mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
